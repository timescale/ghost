#!/bin/sh
set -e

web_output=$(cd web && ./bun --silent run check 2>&1) || { echo "$web_output"; exit 1; }
./scripts/build-web.sh

go mod tidy
# Build and test through the Makefile, which carries the linker flags every
# built binary needs (see the Makefile for details).
make install
go fmt ./...
go fix -omitzero=false ./...
go vet ./...
go tool staticcheck ./...
test_output=$(make test 2>&1) || { echo "$test_output"; exit 1; }
echo ok
